# ─────────────────────────────────────────────────────────────────────────
# Environment variables for the Blackhole Audio Visualizer.
#
# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.example .env.local
#
# Heads up: this app is wired to a specific cloud stack (Convex + Auth0 + R2 +
# a few AI providers). It will NOT boot with these unset. There is no built-in
# local/offline mode. If you only want the visualizer engine, the audio
# analysis (apps/web/lib/audio) and the renderer (apps/web/components/
# BlackHoleSimulation) have no backend dependencies and can be lifted out.
# ─────────────────────────────────────────────────────────────────────────


# ── Convex (backend: database, functions, file metadata) ───────────────────
# Created by `bunx convex dev` in packages/backend. The dev command prints
# this URL and writes it for you; copy it here for the web app.
# Required to boot.
NEXT_PUBLIC_CONVEX_URL=

# Public site URL Convex uses for auth callbacks / HTTP actions.
# Local dev: http://localhost:3000
CONVEX_SITE_URL=


# ── Auth0 (web authentication) ─────────────────────────────────────────────
# From your Auth0 application settings. The web app wraps everything in
# Auth0Provider, so these are required to boot the web build.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=


# ── Cloudflare R2 (S3-compatible storage: recordings, releases) ────────────
# Set on the Convex deployment (these are read server-side in the backend),
# not exposed to the browser. Needed for recording upload/playback and
# release distribution.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=


# ── AI providers (scene generation, song generation, transcription) ────────
# Only needed for the AI "scenes" feature set. The core visualizer and preset
# management work without these.

# OpenRouter — LLM access for the scene agent.
OPENROUTER_API_KEY=

# ElevenLabs — voice / audio generation.
ELEVENLABS_API_KEY=

# Coconut — media transcoding for generated songs.
COCONUT_API_KEY=

# Traceflow — agent tracing / observability (optional).
TRACEFLOW_API_KEY=
